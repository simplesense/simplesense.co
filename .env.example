# =============================================================================
# Simple Sense — environment template. Copy to `.env`. NEVER commit real values.
# The config module (packages/config) validates these at startup and fails fast
# when a REQUIRED var is missing. Vars marked (mockable) can stay empty in local
# dev — the relevant integration runs against its in-package mock until supplied.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Postgres) -----------------------------------------------------
# Prod: a Neon/Supabase pooled URL in DATABASE_URL + direct URL in DIRECT_URL.
# Local dev/test: leave BOTH empty to use the embedded PGlite database
# (zero-dependency Postgres, no Docker/server needed). See DECISIONS.md ADR-002.
DATABASE_URL=
DIRECT_URL=

# --- Token encryption (REQUIRED) ---------------------------------------------
# 32-byte key, base64. Generate: `openssl rand -base64 32`
# Used to encrypt Shopify OAuth tokens at rest (Prime Directive #2).
APP_ENCRYPTION_KEY=

# --- Auth: Clerk (mockable in dev via a dev-auth shim) -----------------------
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Shopify (mockable) ------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers,read_products,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# --- Anthropic / LLM (mockable — engine uses a mock LLM until set) -----------
ANTHROPIC_API_KEY=
# Model id is read from env so it can be swapped without code changes.
# Verify the current recommended model at docs.claude.com before launch.
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# --- Background jobs: Inngest (mockable) -------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Billing: Stripe (mockable) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# --- Outbound integration exports (mockable) ---------------------------------
KLAVIYO_API_KEY=
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- Email: Resend (mockable) ------------------------------------------------
RESEND_API_KEY=

# --- Observability / analytics (optional) ------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
